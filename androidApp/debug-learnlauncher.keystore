# TEXT PLACEHOLDER — not a real JKS.
# Generate a real keystore at the path declared in .env ($ANDROID_DEBUG_KEYSTORE_PATH):
#
#   keytool -genkeypair -v -keystore "$ANDROID_DEBUG_KEYSTORE_PATH" \
#     -alias "learnlauncher" -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass "$ANDROID_DEBUG_STORE_PASSWORD" \
#     -keypass  "$ANDROID_DEBUG_KEY_PASSWORD" \
#     -dname    "CN=learnlauncher-debug"
#
# The committed *.keystore file is a text stub; .gitignore protects *.keystore.real.
