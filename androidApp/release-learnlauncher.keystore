# TEXT PLACEHOLDER — not a real JKS.
# Generate a real keystore at the path declared in .env ($ANDROID_RELEASE_KEYSTORE_PATH):
#
#   keytool -genkeypair -v -keystore "$ANDROID_RELEASE_KEYSTORE_PATH" \
#     -alias "learnlauncher_release" -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass "$ANDROID_RELEASE_STORE_PASSWORD" \
#     -keypass  "$ANDROID_RELEASE_KEY_PASSWORD" \
#     -dname    "CN=learnlauncher-release"
#
# The committed *.keystore file is a text stub; .gitignore protects *.keystore.real.
